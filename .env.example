# .env.example — Copie para .env e preencha os valores
# NUNCA commitar o arquivo .env!

# Semantic Scholar API (gratuita, registrar em https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=your_key_here

# Unpaywall (apenas e-mail institucional)
UNPAYWALL_EMAIL=your.email@institution.edu.br

# Crossref (opcional, aumenta rate limit)
CROSSREF_EMAIL=your.email@institution.edu.br

# Projeto e autor
PROJECT_NAME=rbfin-offline-rl
AUTHOR_NAME=Gustavo
INSTITUTION=UFPR

# Paths (opcional, sobrescreve defaults)
# DATA_DIR=./data
# OUTPUT_DIR=./outputs
# LATEX_DIR=./latex
